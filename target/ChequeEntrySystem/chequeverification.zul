<?xml version="1.0" encoding="UTF-8"?>
<?component name="verificationbox" class="com.iispl.components.VerificationBox" macroURI="/components/verificationbox.zul"?>
<?component name="errorlabel"      class="com.iispl.components.ErrorLabel"      macroURI="/components/errorLabel.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
<style src="/styling/index.css" />

<window apply="com.iispl.controller.ChequeVerificationController"
        border="none" width="100%">
    <div sclass="page-wrap">

        <!-- Banner -->
        <div sclass="page-banner">
            <label sclass="banner-title" value="Cheque Entry and Verification"/>
            <label sclass="banner-sub"   value="Search by cheque number to auto-fill or enter details manually"/>
        </div>

        <!-- Search card using VerificationBox -->
        <div sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Cheque Verification"/></div>
            <div sclass="card-body">
                <verificationbox id="chequeVerifyBox"/>
                <errorlabel id="searchError"/>
            </div>
        </div>

        <!-- Cheque details panel (shown after verify) -->
        <div id="detailsSection" sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Cheque Details"/></div>
            <div sclass="card-body">

                <div sclass="form-grid">
                    <div sclass="field-group">
                        <label sclass="field-label" value="Amount (₹) *"/>
                        <textbox id="txAmountBox" sclass="field-input" placeholder="Enter amount" width="100%"/>
                    </div>
                    <div sclass="field-group">
                        <label sclass="field-label" value="Account Number *"/>
                        <textbox id="txAccountBox" sclass="field-input" placeholder="Enter account number" width="100%"/>
                    </div>
                    <div sclass="field-group">
                        <label sclass="field-label" value="Present Date"/>
                        <textbox id="txDateBox" sclass="field-input" readonly="true" width="100%"/>
                    </div>
                    <div sclass="field-group">
                        <label sclass="field-label" value="Receiver Name *"/>
                        <textbox id="txReceiverBox" sclass="field-input" placeholder="Enter receiver name" width="100%"/>
                    </div>
                </div>

                <div sclass="field-group" style="margin-top:14px;">
                    <label sclass="field-label" value="MICR Code *"/>
                    <textbox id="txMicrBox" sclass="field-input" placeholder="Enter MICR code" width="360px"/>
                </div>

                <errorlabel id="enterError"/>

                <div sclass="btn-row">
                    <button id="enterChequeBtn" label="Enter Cheque →" sclass="btn-primary"/>
                </div>

            </div>
        </div>

    </div>
</window>
</zk>