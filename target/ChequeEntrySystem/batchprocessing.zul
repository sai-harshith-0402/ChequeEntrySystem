<?xml version="1.0" encoding="UTF-8"?>
<?component name="dynamicbutton" class="com.iispl.components.DynamicButton" macroURI="/components/dynamicbutton.zul"?>
<?component name="dynamictable"  class="com.iispl.components.DynamicTable"  macroURI="/components/dynamictable.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: 'Segoe UI', sans-serif; background: #f0f4f8; }

.page-wrap    { max-width: 1100px; margin: 0 auto; padding: 28px 20px; }
.page-banner  { background: #1a56db; border-radius: 12px; padding: 20px 26px;
                margin-bottom: 22px; display: flex; align-items: center;
                justify-content: space-between; }
.banner-title { font-size: 20px; font-weight: 700; color: #fff; }
.banner-sub   { font-size: 13px; color: #bfdbfe; margin-top: 3px; display: block; }

/* Metric pills */
.metrics-row  { display: flex; gap: 16px; margin-bottom: 20px; }
.metric-pill  { background: #fff; border-radius: 10px; border: 1px solid #e5e7eb;
                padding: 14px 22px; flex: 1;
                box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.metric-label { font-size: 12px; color: #6b7280; margin-bottom: 4px; display: block; }
.metric-value { font-size: 26px; font-weight: 700; color: #1a56db; display: block; }

.card         { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(0,0,0,.06); overflow: hidden; }
.card-head    { background: #1a56db; padding: 13px 20px;
                display: flex; align-items: center; justify-content: space-between; }
.card-head-title { font-size: 14px; font-weight: 600; color: #fff; }

/* table overrides */
.custom-table { width: 100%; }

/* button row */
.action-row   { display: flex; gap: 12px; padding: 16px 20px;
                border-top: 1px solid #e5e7eb; background: #f9fafb; }

.verify-btn   { background: #1a56db; color: #fff; border: none; border-radius: 8px;
                padding: 9px 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
.verify-btn:hover { background: #1e40af; }
.verify-btn.secondary { background: #fff; color: #1a56db; border: 1.5px solid #1a56db; }
.verify-btn.secondary:hover { background: #eff6ff; }
</style>

<window apply="com.iispl.controller.BatchProcessingController"
        border="none" width="100%">
    <div sclass="page-wrap">

        <!-- Banner -->
        <div sclass="page-banner">
            <vbox>
                <label sclass="banner-title" value="Batch Processing"/>
                <label sclass="banner-sub"   value="Review entered cheques and generate CXF batch file for NPCI"/>
            </vbox>
        </div>

        <!-- Metric pills -->
        <hlayout sclass="metrics-row" spacing="16px">
            <div sclass="metric-pill">
                <label sclass="metric-label" value="Total Cheques Entered"/>
                <label id="totalChequeLabel" sclass="metric-value" value="0"/>
            </div>
            <div sclass="metric-pill">
                <label sclass="metric-label" value="Total Batches"/>
                <label id="totalBatchLabel" sclass="metric-value" value="0"/>
            </div>
            <div sclass="metric-pill">
                <label sclass="metric-label" value="Cheques per Batch"/>
                <label sclass="metric-value" value="5"/>
            </div>
        </hlayout>

        <!-- Batch table card -->
        <div sclass="card">
            <div sclass="card-head">
                <label sclass="card-head-title" value="All Cheque Batches"/>
            </div>

            <dynamictable id="batchTable"/>

            <div sclass="action-row">
                <dynamicbutton id="addMoreBtn"/>
                <dynamicbutton id="generateBtn"/>
            </div>
        </div>

    </div>
</window>
</zk>