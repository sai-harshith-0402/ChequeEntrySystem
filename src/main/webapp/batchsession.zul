<?xml version="1.0" encoding="UTF-8"?>
<?component name="dynamicbutton" class="com.iispl.components.DynamicButton" macroURI="/components/dynamicbutton.zul"?>
<?component name="dynamictable"  class="com.iispl.components.DynamicTable"  macroURI="/components/dynamictable.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
<style src="/styling/batchsession.css"/>

<window apply="com.iispl.controller.BatchSessionController"
        border="none" width="100%">
    <div sclass="page-wrap">

        <div sclass="page-banner">
            <label sclass="banner-title" value="Batch Status"/>
            <label sclass="banner-sub"   value="All processed batch results from NPCI validation"/>
        </div>

        <div sclass="card">
            <div sclass="card-head">
                <label sclass="card-head-title" value="batch_status Table"/>
            </div>

            <dynamictable id="statusTable"/>

            <div sclass="action-row">
                <dynamicbutton id="backBtn"/>
            </div>
        </div>

    </div>
</window>
</zk>