<?xml version="1.0" encoding="UTF-8"?>
<?component name="verificationbox" class="com.iispl.components.VerificationBox" macroURI="/components/verificationbox.zul"?>
<?component name="dynamictable"    class="com.iispl.components.DynamicTable"    macroURI="/components/dynamictable.zul"?>
<?component name="dynamicbutton"   class="com.iispl.components.DynamicButton"   macroURI="/components/dynamicbutton.zul"?>
<?component name="errorlabel"      class="com.iispl.components.ErrorLabel"      macroURI="/components/errorLabel.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: 'Segoe UI', sans-serif; background: #f0f4f8; }

.page-wrap    { max-width: 1100px; margin: 0 auto; padding: 28px 20px; }
.page-banner  { background: #1a56db; border-radius: 12px; padding: 20px 26px;
                margin-bottom: 22px; }
.banner-title { font-size: 20px; font-weight: 700; color: #fff; display: block; }
.banner-sub   { font-size: 13px; color: #bfdbfe; margin-top: 3px; display: block; }

.card         { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 20px; overflow: hidden; }
.card-head    { background: #1a56db; padding: 13px 20px; }
.card-head-title { font-size: 14px; font-weight: 600; color: #fff; }
.card-body    { padding: 20px; }

.action-row   { display: flex; gap: 12px; padding: 16px 20px;
                border-top: 1px solid #e5e7eb; background: #f9fafb; }

.verify-btn   { background: #1a56db; color: #fff; border: none; border-radius: 8px;
                padding: 9px 20px; font-size: 13px; font-weight: 600; cursor: pointer; }
.verify-btn:hover { background: #1e40af; }
.verify-btn.danger { background: #dc2626; }
.verify-btn.danger:hover { background: #b91c1c; }

#mc_errorLabel { color: #dc2626; font-size: 12px; margin-top: 6px; display: block; }
</style>

<window apply="com.iispl.controller.NPCIValidationController"
        border="none" width="100%">
    <div sclass="page-wrap">

        <!-- Banner -->
        <div sclass="page-banner">
            <label sclass="banner-title" value="NPCI Validation"/>
            <label sclass="banner-sub"   value="Search a batch from CXF.XML and mark it as Valid or Reject"/>
        </div>

        <!-- Search using VerificationBox -->
        <div sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Batch Search"/></div>
            <div sclass="card-body">
                <verificationbox id="batchVerifyBox"/>
                <errorlabel id="searchError"/>
            </div>
        </div>

        <!-- Batch detail table + decision buttons (shown after search) -->
        <div id="batchDetailSection" sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Batch Cheques"/></div>
            <dynamictable id="npciTable"/>
            <div sclass="action-row">
                <dynamicbutton id="validBtn"/>
                <dynamicbutton id="rejectBtn"/>
            </div>
        </div>

    </div>
</window>
</zk>