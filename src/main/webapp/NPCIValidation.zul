<?xml version="1.0" encoding="UTF-8"?>
<?component name="verificationbox" class="com.iispl.components.VerificationBox" macroURI="/components/verificationbox.zul"?>
<?component name="dynamictable"    class="com.iispl.components.DynamicTable"    macroURI="/components/dynamictable.zul"?>
<?component name="dynamicbutton"   class="com.iispl.components.DynamicButton"   macroURI="/components/dynamicbutton.zul"?>
<?component name="errorlabel"      class="com.iispl.components.ErrorLabel"      macroURI="/components/errorLabel.zul"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

<style src="/styling/NPCIValidation.css"/>
<window apply="com.iispl.controller.NPCIValidationController"
        border="none" width="100%">
    <div sclass="page-wrap">

        <!-- Banner -->
        <div sclass="page-banner">
            <label sclass="banner-title" value="NPCI Validation"/>
            <label sclass="banner-sub"   value="Search a batch from CXF.XML and mark it as Valid or Reject"/>
        </div>

        <!-- Search using VerificationBox -->
        <div sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Batch Search"/></div>
            <div sclass="card-body">
                <verificationbox id="batchVerifyBox"/>
                <errorlabel id="searchError"/>
            </div>
        </div>

        <!-- Batch detail table + decision buttons (shown after search) -->
        <div id="batchDetailSection" sclass="card">
            <div sclass="card-head"><label sclass="card-head-title" value="Batch Cheques"/></div>
            <dynamictable id="npciTable"/>
            <div sclass="action-row">
                <dynamicbutton id="validBtn"/>
                <dynamicbutton id="rejectBtn"/>
            </div>
        </div>

    </div>
</window>
</zk>